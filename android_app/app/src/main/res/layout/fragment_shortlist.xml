<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Shortlist Header Card with Capacity Progress -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_shortlist_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/card_background"
        app:strokeWidth="1dp"
        app:strokeColor="@color/divider"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_shortlist_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DEVICE SHORTLIST"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/btn_clear_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clear All"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/status_disconnected"
                android:background="?attr/selectableItemBackground"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_capacity_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5 / 20 Slots Filled"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginTop="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_shortlist_title" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress_capacity"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:max="20"
                android:progress="5"
                android:layout_marginTop="8dp"
                app:indicatorColor="@color/secondary"
                app:trackColor="#FFE0B2"
                app:trackCornerRadius="4dp"
                app:layout_constraintTop_toBottomOf="@id/tv_capacity_count" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Only these items will be synced to the scale wheel. Limit: 20 items."
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="6dp"
                app:layout_constraintTop_toBottomOf="@id/progress_capacity" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Shortlist Recycler View -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_shortlist"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/card_shortlist_status"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/tv_shortlist_empty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Shortlist is empty.\n\nGo to the Food Database tab and tap the star icon next to foods you want on your scale."
        android:textSize="15sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_shortlist_status"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
