<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/card_background"
    app:strokeWidth="1dp"
    app:strokeColor="@color/divider">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Slot Pill -->
        <TextView
            android:id="@+id/tv_slot_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SLOT 00"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/secondary_variant"
            android:background="#FFF3E0"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Food Name -->
        <TextView
            android:id="@+id/tv_shortlist_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Mustard Oil"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_slot_badge"
            app:layout_constraintEnd_toStartOf="@id/btn_remove_shortlist" />

        <!-- Per 100g Macros -->
        <TextView
            android:id="@+id/tv_shortlist_macros"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Per 100g: 884 kcal | P: 0g | F: 100g | C: 0g"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_shortlist_name"
            app:layout_constraintEnd_toStartOf="@id/btn_remove_shortlist" />

        <!-- Remove Icon Button -->
        <ImageView
            android:id="@+id/btn_remove_shortlist"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_delete"
            app:tint="@color/status_disconnected"
            android:contentDescription="Remove from Shortlist"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
